<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Clima de hoy -->
    <TextView
        android:id="@+id/textSaludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BUENOS DÍAS BANANI"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textSemana"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lunes, 08:30 AM"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/textSaludo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgClima"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textSemana"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="25°C"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imgClima"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Iconos -->
    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textTemp"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/baseline_thermostat_24" />

    <TextView
        android:id="@+id/textNumTemperatura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sen:27°C"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textTemp"
        app:layout_constraintStart_toEndOf="@id/imageView3"
        app:layout_constraintBottom_toBottomOf="@id/imageView3" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textTemp"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/air" />

    <TextView
        android:id="@+id/textNumWind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vien:10 km/h"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textTemp"
        app:layout_constraintEnd_toStartOf="@id/imageView2"
        app:layout_constraintBottom_toBottomOf="@id/imageView2" />

    <!-- Lista semanal -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewWeather"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/imageView2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
